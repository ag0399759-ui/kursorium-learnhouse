# ============================================================
# KURSORIUM — ШАБЛОН СЕКРЕТНИХ КЛЮЧІВ
# ============================================================
# Цей файл — ШАБЛОН. Реальні значення тримай в .env
# Файл .env НЕ йде на GitHub (він в .gitignore)
# ============================================================

# --- RAILWAY (хостинг) ---
# Де взяти: railway.app → Account Settings → Tokens → Create Token
RAILWAY_TOKEN=

# Railway Project (знайди в URL dashboard: railway.app/project/ХХХ)
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=

# Railway Services (знайди в Railway Dashboard → Settings кожного сервісу)
RAILWAY_SERVICE_LEARNHOUSE=
RAILWAY_SERVICE_POSTGRES=
RAILWAY_SERVICE_REDIS=

# --- CLOUDFLARE (DNS + захист сайту) ---
# Де взяти: dash.cloudflare.com → My Profile → API Tokens
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=

# Де взяти: dash.cloudflare.com → обери домен → Overview → справа внизу
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# --- GITHUB ---
# Де взяти: github.com → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=
GITHUB_REPO=ag0399759-ui/kursorium-learnhouse

# --- LEARNHOUSE ---
# URL твого деплою на Railway (знайдеш в Railway Dashboard)
LEARNHOUSE_URL=https://learnhouse-production-XXXXX.up.railway.app
LEARNHOUSE_DOMAIN=kursorium.com
ADMIN_EMAIL=
